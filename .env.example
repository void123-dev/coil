# Copy to .env on your machine. Never commit .env.
# COIL runs without any of these.

# Optional. CoinGlass v4 Professional+. Liquidation-map overlay only.
# Header sent as CG-API-KEY. Unset → liq.available=false.
COINGLASS_API_KEY=

# Optional live-pit override: okx | bybit | binance | all
# COIL_DEFAULT_VENUE=okx

# Inventory adapter. Keep off unless you have a JSON feed.
MM_FLOW_SOURCE=off
# MM_FLOW_URL=

# Sibling Gravity origin. Fail-soft, not mixed into score.
# GRAVITY_API_BASE=
